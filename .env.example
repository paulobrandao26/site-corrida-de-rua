# Copie este arquivo para .env e preencha. NUNCA suba o .env para o GitHub.
# Access Token em: mercadopago.com.br/developers > Suas integrações > Credenciais
# Use primeiro as credenciais de TESTE.
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações > Webhooks). Opcional, mas recomendado.
MP_WEBHOOK_SECRET=
# Endereço público do site (no Vercel/servidor use https://...)
BASE_URL=http://localhost:3001
PORT=3001
